{
  "name": "jolt",
  "private": true,
  "description": "Open-source, federated, self-hostable chat.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter @getjolt/server dev",
    "dev:desktop": "pnpm --filter @getjolt/desktop dev",
    "dev:web": "pnpm --filter @getjolt/web dev",
    "build:web": "turbo run build --filter=@getjolt/web",
    "serve:web": "pnpm --filter @getjolt/web serve",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
