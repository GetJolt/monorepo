# One domain serves the Jolt instance and the website. Desktop downloads and updates come from GitHub releases.
{$JOLT_DOMAIN} {
	encode zstd gzip

	@instance path /api/* /gateway /.well-known/* /health
	handle @instance {
		reverse_proxy jolt:4000
	}

	handle {
		root * /srv/site
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'none'"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			-Server
		}

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=604800"

		@invite path /invite/*
		rewrite @invite /invite.html

		file_server
	}
}
